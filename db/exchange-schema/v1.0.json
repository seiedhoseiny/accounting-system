{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Accounting Exchange Schema v1.0",
  "type": "object",
  "required": ["schemaVersion", "unitCode", "fiscalYear", "batchId", "documents"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "unitCode": { "type": "string" },
    "fiscalYear": { "type": "integer" },
    "batchId": { "type": "string", "format": "uuid" },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["globalId", "documentNumber", "documentDate", "documentType", "status", "lines"],
        "properties": {
          "globalId": { "type": "string", "format": "uuid" },
          "documentNumber": { "type": "integer", "minimum": 1 },
          "documentDate": { "type": "string" },
          "documentType": { "enum": ["Journal", "Receipt", "Transfer"] },
          "status": { "enum": ["Normal", "Correction"] },
          "correctsDocumentGlobalId": { "type": ["string", "null"], "format": "uuid" },
          "description": { "type": "string" },
          "totalDebit": { "type": "number" },
          "totalCredit": { "type": "number" },
          "lines": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["lineNumber", "accountCode", "debit", "credit"],
              "properties": {
                "lineNumber": { "type": "integer" },
                "accountCode": { "type": "string" },
                "description": { "type": "string" },
                "debit": { "type": "number", "minimum": 0 },
                "credit": { "type": "number", "minimum": 0 },
                "detailAccounts": { "type": "array", "items": { "type": "object" } }
              }
            }
          }
        }
      }
    }
  }
}
